# ===================================
# PX BugHunter Configuration
# ===================================
# Copy this file to .env and update the values as needed

# -----------------------------------
# Application Metadata
# -----------------------------------
APP_NAME=PX BugHunter
APP_VERSION=0.1.0
APP_DESCRIPTION=FastAPI application for receiving and processing Datadog bug report webhooks

# -----------------------------------
# Server Configuration
# -----------------------------------
# Host address for the server (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0
# Port number for the server (1-65535)
PORT=8000

# -----------------------------------
# Environment & Debug Settings
# -----------------------------------
# Environment: development, staging, or production
ENVIRONMENT=development
# Enable debug mode (true/false) - should be false in production
DEBUG=false

# -----------------------------------
# CORS Configuration
# -----------------------------------
# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,http://localhost:8000,https://example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Allow credentials (cookies, authorization headers) in CORS requests (true/false)
CORS_ALLOW_CREDENTIALS=true
# Comma-separated list of allowed HTTP methods (* for all methods)
CORS_ALLOW_METHODS=*
# Comma-separated list of allowed headers (* for all headers)
CORS_ALLOW_HEADERS=*

# -----------------------------------
# Logging Configuration
# -----------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
